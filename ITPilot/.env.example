# Copy this file to .env and replace the placeholders. Do not commit .env.
ANTHROPIC_API_KEY=replace_with_your_api_key
ANTHROPIC_MODEL=replace_with_your_messages_compatible_model
# Set only when using a third-party Anthropic Messages-compatible endpoint.
# ANTHROPIC_BASE_URL=https://your-provider.example/anthropic

# Use a strong alphanumeric value; Compose uses it for both Redis and the app URL.
REDIS_PASSWORD=replace_with_a_strong_password

# API authentication. Use distinct, randomly generated tokens (24+ characters).
# The JSON maps each user ID to its own token; do not commit the real values.
ITPILOT_USER_TOKENS={"u1001":"replace_with_a_random_user_token_at_least_24_chars"}
ITPILOT_ADMIN_TOKEN=replace_with_a_different_random_admin_token_at_least_24_chars

# Optional: comma-separated browser origins. Defaults to localhost:5173/5174.
# ITPILOT_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional application settings.
LOG_LEVEL=INFO
ITPILOT_SKILLS_MAX_PROMPT_CHARS=5000
